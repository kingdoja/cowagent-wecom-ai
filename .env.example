# CowAgent image and local web entry
COWAGENT_IMAGE=zhayujie/chatgpt-on-wechat@sha256:1982e564243455957e5c39e3bc5b313e2f89a2a39b654a378fdf22cf5991f831
COWAGENT_PLATFORM=linux/amd64
COWAGENT_BIND_HOST=127.0.0.1
COWAGENT_WEB_PORT=9899
COWAGENT_LOCAL_WEB_PORT=19999
COWAGENT_WEB_PASSWORD=replace-with-a-long-random-password

# OpenAI-compatible relay
RELAY_API_BASE=https://relay.example.com/v1
RELAY_API_KEY=replace-with-a-dedicated-sub-key
RELAY_MODEL=replace-with-the-relay-model-name
# CowAgent's OpenAI-compatible text path normally uses Chat Completions.
# The relay test script also supports: responses
RELAY_API_MODE=chat_completions

# Start with agent tools disabled. Enable only after container isolation and
# repository allowlists are in place.
COWAGENT_AGENT_ENABLED=False
COWAGENT_SELF_EVOLUTION_ENABLED=False
COWAGENT_MAX_CONTEXT_TOKENS=20000
COWAGENT_MAX_CONTEXT_TURNS=10
COWAGENT_MAX_STEPS=6
COW_STREAMING_PATCH_ENABLED=True

# WeCom Bot credentials are entered through CowAgent's QR-code onboarding or
# manual form. They are persisted under data/cow and are not kept in .env.
