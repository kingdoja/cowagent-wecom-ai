# OpenClaw reads this file from ~/.openclaw/.env.
# Create a new relay sub-key; do not reuse CowAgent's key.
RELAY_API_BASE=https://relay.example.com/v1
RELAY_API_KEY=replace-with-a-new-openclaw-only-sub-key

# Generated by scripts/openclaw-configure.sh after FileVault is enabled.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token

# Derived automatically from the active Tailscale MagicDNS name.
OPENCLAW_TAILSCALE_ORIGIN=https://device-name.tailnet-name.ts.net
