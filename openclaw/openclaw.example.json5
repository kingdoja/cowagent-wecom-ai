{
  models: {
    mode: "replace",
    providers: {
      relay: {
        baseUrl: "${RELAY_API_BASE}",
        apiKey: { source: "env", provider: "default", id: "RELAY_API_KEY" },
        auth: "api-key",
        api: "openai-completions",
        timeoutSeconds: 180,
        models: [
          {
            id: "gpt-5.5",
            name: "GPT-5.5",
            reasoning: true,
            input: ["text", "image"],
            agentRuntime: { id: "openclaw" },
            compat: {
              supportsTools: true,
              supportsReasoningEffort: true,
              supportsUsageInStreaming: true,
            },
          },
          {
            id: "gpt-5.6-terra",
            name: "GPT-5.6 Terra",
            reasoning: true,
            input: ["text", "image"],
            agentRuntime: { id: "openclaw" },
            compat: {
              supportsTools: true,
              supportsReasoningEffort: true,
              supportsUsageInStreaming: true,
            },
          },
          {
            id: "gpt-5.6-sol",
            name: "GPT-5.6 Sol",
            reasoning: true,
            input: ["text", "image"],
            agentRuntime: { id: "openclaw" },
            compat: {
              supportsTools: true,
              supportsReasoningEffort: true,
              supportsUsageInStreaming: true,
            },
          },
          {
            id: "gpt-5.4-mini",
            name: "GPT-5.4 Mini",
            reasoning: true,
            input: ["text", "image"],
            agentRuntime: { id: "openclaw" },
            compat: {
              supportsTools: true,
              supportsReasoningEffort: true,
              supportsUsageInStreaming: true,
            },
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      workspace: "~/OpenClawWorkspace",
      skills: ["healthcheck"],
      model: {
        primary: "relay/gpt-5.4-mini",
        fallbacks: [],
      },
      utilityModel: "relay/gpt-5.4-mini",
      thinkingDefault: "low",
      reasoningDefault: "on",
      timeoutSeconds: 600,
      models: {
        "relay/gpt-5.4-mini": {
          alias: "daily",
          params: { reasoningEffort: "low" },
          agentRuntime: { id: "openclaw" },
          streaming: true,
        },
        "relay/gpt-5.5": {
          alias: "smart",
          params: { reasoningEffort: "medium" },
          agentRuntime: { id: "openclaw" },
          streaming: true,
        },
        "relay/gpt-5.6-sol": {
          alias: "sol",
          params: { reasoningEffort: "high" },
          agentRuntime: { id: "openclaw" },
          streaming: true,
        },
        "relay/gpt-5.6-terra": {
          alias: "terra",
          params: { reasoningEffort: "high" },
          agentRuntime: { id: "openclaw" },
          streaming: true,
        },
      },
      sandbox: {
        mode: "all",
        backend: "docker",
        scope: "session",
        workspaceAccess: "rw",
        workspaceRoot: "~/.openclaw/sandboxes",
        docker: {
          image: "cowagent-openclaw-sandbox:2026.7.1",
          containerPrefix: "openclaw-sbx-",
          workdir: "/workspace",
          readOnlyRoot: true,
          network: "none",
          user: "1000:1000",
          capDrop: ["ALL"],
          tmpfs: [
            "/tmp:rw,noexec,nosuid,size=256m",
            "/run:rw,noexec,nosuid,size=16m",
          ],
          pidsLimit: 256,
          memory: "2g",
          memorySwap: "2g",
          cpus: 2,
          binds: [],
        },
        browser: {
          enabled: false,
          allowHostControl: false,
          autoStart: false,
        },
        prune: { idleHours: 24, maxAgeDays: 7 },
      },
    },
  },

  tools: {
    allow: [
      "read",
      "write",
      "edit",
      "apply_patch",
      "exec",
      "process",
      "web_search",
      "web_fetch",
      "memory_search",
      "memory_get",
    ],
    deny: [
      "browser",
      "canvas",
      "code_execution",
      "x_search",
      "message",
      "cron",
      "gateway",
      "nodes",
      "sessions_send",
      "sessions_spawn",
      "sessions_yield",
      "subagents",
      "agents_list",
      "update_plan",
      "heartbeat_respond",
      "image_generate",
      "music_generate",
      "video_generate",
      "tts",
    ],
    fs: { workspaceOnly: true },
    exec: {
      host: "sandbox",
      security: "full",
      ask: "off",
      strictInlineEval: true,
      commandHighlighting: true,
      notifyOnExit: false,
      applyPatch: { enabled: true, workspaceOnly: true },
    },
    elevated: { enabled: false, allowFrom: {} },
    sandbox: {
      tools: {
        allow: [
          "read",
          "write",
          "edit",
          "apply_patch",
          "exec",
          "process",
          "web_search",
          "web_fetch",
          "memory_search",
          "memory_get",
        ],
        deny: [
          "browser",
          "canvas",
          "code_execution",
          "x_search",
          "message",
          "cron",
          "gateway",
          "nodes",
          "sessions_send",
          "sessions_spawn",
          "sessions_yield",
          "subagents",
        ],
      },
    },
    web: {
      search: {
        enabled: true,
        provider: "parallel-free",
        maxResults: 5,
        timeoutSeconds: 30,
        cacheTtlMinutes: 15,
        openaiCodex: { enabled: false },
      },
      fetch: {
        enabled: true,
        maxChars: 30000,
        maxCharsCap: 50000,
        maxResponseBytes: 2000000,
        timeoutSeconds: 30,
        cacheTtlMinutes: 15,
        maxRedirects: 3,
        readability: true,
        useTrustedEnvProxy: false,
      },
    },
  },

  plugins: {
    enabled: true,
    allow: ["memory-core", "parallel", "openclaw-weixin"],
    bundledDiscovery: "allowlist",
    load: { paths: [] },
    slots: { memory: "memory-core" },
    entries: {
      "memory-core": { enabled: true },
      parallel: { enabled: true },
      "openclaw-weixin": { enabled: true },
    },
  },

  channels: {
    "openclaw-weixin": {
      enabled: true,
      dmPolicy: "pairing",
      botAgent: "OpenClawPersonal/2026.7.1",
    },
  },

  session: { dmScope: "per-account-channel-peer" },

  commands: {
    text: true,
    bash: false,
    config: false,
    mcp: false,
    plugins: false,
    debug: false,
    restart: false,
    ownerDisplay: "hash",
  },

  gateway: {
    mode: "local",
    port: 18789,
    bind: "loopback",
    trustedProxies: ["127.0.0.1", "::1"],
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
      // Tailnet identity avoids re-entering the tab-scoped Control UI token.
      // HTTP APIs still require the gateway token.
      allowTailscale: true,
      rateLimit: {
        maxAttempts: 5,
        windowMs: 60000,
        lockoutMs: 300000,
        exemptLoopback: true,
      },
    },
    tailscale: {
      mode: "serve",
      resetOnExit: false,
      preserveFunnel: false,
    },
    controlUi: {
      enabled: true,
      allowedOrigins: [
        "http://127.0.0.1:18789",
        "${OPENCLAW_TAILSCALE_ORIGIN}",
      ],
      embedSandbox: "strict",
      allowExternalEmbedUrls: false,
      dangerouslyAllowHostHeaderOriginFallback: false,
      allowInsecureAuth: false,
      dangerouslyDisableDeviceAuth: false,
    },
    terminal: { enabled: false, detachedSessionTimeoutSeconds: 0 },
    nodes: {
      browser: { mode: "off" },
      allowCommands: [],
      denyCommands: ["system.run"],
    },
  },
}
