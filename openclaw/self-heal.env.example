# Stored as ~/.openclaw/self-heal.env with mode 0600.
OPENCLAW_SELF_HEAL_FAILURE_THRESHOLD=2
# Start Docker Desktop automatically when a sandbox error reports that the daemon is down.
OPENCLAW_SELF_HEAL_DOCKER_AUTO_START=1
OPENCLAW_SELF_HEAL_DOCKER_APP=Docker
OPENCLAW_SELF_HEAL_DOCKER_START_TIMEOUT_SECONDS=90
OPENCLAW_SELF_HEAL_CANDIDATES=primary,backup

OPENCLAW_SELF_HEAL_PRIMARY_BASE_URL=https://primary.example/v1
OPENCLAW_SELF_HEAL_PRIMARY_KEY_FILE=/path/to/protected-primary.env
OPENCLAW_SELF_HEAL_PRIMARY_KEY_NAME=RELAY_API_KEY
OPENCLAW_SELF_HEAL_PRIMARY_MODEL=gpt-5.6-terra
OPENCLAW_SELF_HEAL_PRIMARY_MODEL_NAME=GPT-5.6 Terra

OPENCLAW_SELF_HEAL_BACKUP_BASE_URL=https://backup.example/v1
OPENCLAW_SELF_HEAL_BACKUP_KEY_FILE=/path/to/protected-backup.env
OPENCLAW_SELF_HEAL_BACKUP_KEY_NAME=RELAY_API_KEY
OPENCLAW_SELF_HEAL_BACKUP_MODEL=external/gpt-5.6-terra
OPENCLAW_SELF_HEAL_BACKUP_MODEL_NAME=GPT-5.6 Terra Backup
